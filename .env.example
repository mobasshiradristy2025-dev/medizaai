# Environment Configuration Template for Medizaai

# Node Environment
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medizaai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medizaai

# NestJS API Backend
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=super-secret-development-key-change-in-production
JWT_EXPIRES_IN=7d

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Business Config Defaults (Rajshahi initial market)
DEFAULT_DELIVERY_FEE=30
MIN_PHARMACY_ORDER_VALUE=100
AMBULANCE_DISPATCH_TIMEOUT_SECONDS=180
